page {
  min-height: 100%;
  background: #fff7fb;
  color: #2f2530;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.4;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background:
    radial-gradient(circle at 12% 4%, rgba(255, 159, 202, 0.36), transparent 34%),
    radial-gradient(circle at 92% 0%, rgba(162, 126, 255, 0.22), transparent 30%),
    linear-gradient(180deg, #fff7fb 0%, #fbf7ff 48%, #ffffff 100%);
}

.soft-card {
  border: 1rpx solid rgba(255, 128, 184, 0.15);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 20rpx 60rpx rgba(143, 82, 132, 0.12);
  backdrop-filter: blur(18rpx);
}

.primary-button {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0;
  background: linear-gradient(135deg, #ff79b8 0%, #a978ff 100%);
  box-shadow: 0 18rpx 42rpx rgba(209, 93, 178, 0.28);
}

.primary-button[disabled] {
  opacity: 0.58;
}

.ghost-button {
  min-height: 72rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #8b4bcc;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(160, 98, 220, 0.2);
}

.section-title {
  color: #2f2530;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.muted {
  color: #8f7c8e;
}

.safe-area {
  padding-bottom: env(safe-area-inset-bottom);
}
