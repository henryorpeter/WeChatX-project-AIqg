<view class="profile-page" style="padding-top: {{pageTop}}px;">
  <view class="profile-head">
    <image class="avatar" src="{{profile.avatarUrl}}" mode="aspectFit"></image>
    <view class="profile-info">
      <view class="name-row">
        <text class="nickname">{{profile.nickname}}</text>
        <view wx:if="{{vipStatus.active}}" class="member-mark">VIP</view>
        <image class="vip-badge" src="/assets/icons/profile_vip_badge.png" mode="aspectFit"></image>
      </view>
      <view class="slogan-row">
        <text>{{profile.slogan}}</text>
        <image class="profile-heart" src="/assets/icons/profile_heart.png" mode="aspectFit"></image>
      </view>
    </view>
    <button class="edit-button" hover-class="none" bindtap="editProfile">
      <text>编辑资料</text>
      <image class="edit-chevron" src="/assets/icons/profile_edit_chevron.png" mode="aspectFit"></image>
    </button>
  </view>

  <view wx:if="{{showVipEntry}}" class="vip-banner {{vipStatus.active ? 'vip-banner-active' : ''}}">
    <image class="banner-crown" src="/assets/icons/profile_banner_crown.png" mode="aspectFit"></image>
    <view class="banner-copy">
      <view class="banner-title">{{vipStatus.active ? '心依AI 会员中' : '开通 VIP 会员'}}</view>
      <view class="banner-text">{{vipStatus.active ? vipStatus.planName + '权益已生效，可无限分析' : '解锁无限分析、专属报告等特权'}}</view>
    </view>
    <button wx:if="{{!vipStatus.active}}" class="banner-button" hover-class="none" bindtap="openVip">
      <text>立即开通</text>
      <image class="banner-arrow" src="/assets/icons/profile_banner_arrow.png" mode="aspectFit"></image>
    </button>
    <view wx:else class="expire-info">
      <view wx:if="{{vipStatus.planKey !== 'lifetime'}}" class="expire-label">会员到期时间</view>
      <view class="expire-date {{vipStatus.planKey === 'lifetime' ? 'expire-date-lifetime' : ''}}">{{vipStatus.expireText}}</view>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <image class="stat-icon chat-icon" src="/assets/icons/profile_stat_chat.png" mode="aspectFit"></image>
      <view class="stat-value">{{analysisCount}}</view>
      <view class="stat-label">分析总数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <image class="stat-icon star-icon" src="/assets/icons/profile_stat_star.png" mode="aspectFit"></image>
      <view class="stat-value">{{adviceCount}}</view>
      <view class="stat-label">专属建议</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <image class="stat-icon calendar-icon" src="/assets/icons/profile_stat_calendar.png" mode="aspectFit"></image>
      <view class="stat-value">{{streakDays}}</view>
      <view class="stat-label">连续使用天数</view>
    </view>
  </view>

  <view wx:if="{{showVipEntry && !vipStatus.active}}" class="vip-card">
    <view class="vip-card-left">
      <view class="vip-title-row">
        <text class="vip-title">{{vipStatus.active ? vipStatus.planName : '情感分析 VIP'}}</text>
        <image class="small-crown" src="/assets/icons/profile_vip_card_crown.png" mode="aspectFit"></image>
      </view>
      <view class="benefit-grid">
        <view wx:for="{{benefits}}" wx:key="*this" class="benefit-item">
          <image class="check-icon" src="/assets/icons/profile_check_circle.png" mode="aspectFit"></image>
          <text>{{item}}</text>
        </view>
      </view>
    </view>
    <view class="vip-card-art">
      <image class="crystal-heart" src="/assets/icons/profile_vip_crystal_heart.png" mode="aspectFit"></image>
      <button class="vip-action {{vipStatus.active ? 'vip-action-active' : ''}}" hover-class="none" bindtap="openVip">{{vipStatus.active ? '会员中' : '立即开通'}}</button>
    </view>
  </view>

  <view class="menu-card">
    <view wx:for="{{menus}}" wx:key="key" class="menu-item" data-key="{{item.key}}" bindtap="openMenu">
      <image class="menu-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="menu-copy">
        <view class="menu-title">{{item.title}}</view>
        <view class="menu-desc">{{item.desc}}</view>
      </view>
      <image class="menu-chevron" src="/assets/icons/profile_list_chevron.png" mode="aspectFit"></image>
    </view>
  </view>

  <view wx:if="{{activePanel}}" class="sheet-mask" bindtap="closePanel">
    <view class="sheet" catchtap="stopPanelTap">
      <view class="sheet-handle"></view>

      <view wx:if="{{activePanel === 'profile'}}">
        <view class="sheet-title">编辑资料</view>
        <button class="avatar-picker" hover-class="none" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
          <image class="avatar-preview" src="{{profileDraft.avatarUrl}}" mode="aspectFill"></image>
          <text>更换头像</text>
        </button>
        <view class="field-group">
          <view class="field-label">昵称</view>
          <input class="field-input" type="nickname" value="{{profileDraft.nickname}}" maxlength="12" placeholder="请输入微信昵称" data-field="nickname" bindinput="updateProfileDraft" />
        </view>
        <view class="field-group">
          <view class="field-label">签名</view>
          <input class="field-input" value="{{profileDraft.slogan}}" maxlength="24" data-field="slogan" bindinput="updateProfileDraft" />
        </view>
        <button class="primary-action" hover-class="none" bindtap="saveProfile">保存资料</button>
      </view>

      <view wx:elif="{{activePanel === 'feedback'}}">
        <view class="sheet-title">问题反馈</view>
        <view class="type-row">
          <view wx:for="{{feedbackTypes}}" wx:key="*this" class="type-chip {{feedbackDraft.type === item ? 'type-chip-active' : ''}}" data-type="{{item}}" bindtap="selectFeedbackType">{{item}}</view>
        </view>
        <textarea class="feedback-textarea" value="{{feedbackDraft.content}}" maxlength="300" placeholder="遇到的问题、希望优化的地方，都可以写在这里" data-field="content" bindinput="updateFeedbackDraft"></textarea>
        <input class="field-input contact-input" value="{{feedbackDraft.contact}}" placeholder="联系方式（选填）" data-field="contact" bindinput="updateFeedbackDraft" />
        <button class="primary-action" hover-class="none" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting}}" bindtap="submitFeedback">提交反馈</button>
      </view>

      <view wx:elif="{{activePanel === 'contact'}}">
        <view class="contact-hero">
          <view class="contact-badge">心依AI 支持中心</view>
          <view class="contact-title">联系我们</view>
          <view class="contact-subtitle">有功能建议、合作咨询或使用问题，都可以通过下面方式找到我们。</view>
        </view>
        <view class="contact-card contact-card-featured">
          <view class="contact-copy">
            <view class="contact-label">微信客服</view>
            <view class="contact-value">点击进入客服会话</view>
            <view class="contact-desc">适合处理功能问题、使用咨询和紧急反馈</view>
          </view>
          <button class="ghost-action" hover-class="none" open-type="contact" bindcontact="handleContact">联系</button>
        </view>
        <view class="contact-card">
          <view class="contact-copy">
            <view class="contact-label">邮箱</view>
            <view class="contact-value">{{contactInfo.email}}</view>
            <view class="contact-desc">适合商务合作、长期建议和资料补充</view>
          </view>
          <button class="ghost-action" hover-class="none" data-value="{{contactInfo.email}}" bindtap="copyContact">复制</button>
        </view>
      </view>

      <view wx:elif="{{activePanel === 'privacy'}}">
        <view class="sheet-title">隐私与安全</view>
        <view class="switch-row">
          <view>
            <view class="switch-title">分析记录仅保存在本机</view>
            <view class="switch-desc">历史内容不主动上传云端</view>
          </view>
          <switch checked="{{privacySettings.localHistory}}" color="#ef65b2" data-key="localHistory" bindchange="togglePrivacy" />
        </view>
        <view class="switch-row">
          <view>
            <view class="switch-title">匿名体验模式</view>
            <view class="switch-desc">减少个人身份信息展示</view>
          </view>
          <switch checked="{{privacySettings.anonymousMode}}" color="#ef65b2" data-key="anonymousMode" bindchange="togglePrivacy" />
        </view>
        <view class="switch-row">
          <view>
            <view class="switch-title">服务通知</view>
            <view class="switch-desc">接收分析完成与会员提醒</view>
          </view>
          <switch checked="{{privacySettings.serviceNotice}}" color="#ef65b2" data-key="serviceNotice" bindchange="togglePrivacy" />
        </view>
      </view>

      <view wx:elif="{{activePanel === 'settings'}}">
        <view class="sheet-title">设置</view>
        <view class="setting-row" bindtap="clearHistory">
          <view>
            <view class="setting-title">清空历史记录</view>
            <view class="setting-desc">删除本机保存的分析记录</view>
          </view>
          <text class="setting-link">清空</text>
        </view>
        <view class="setting-row" bindtap="resetProfile">
          <view>
            <view class="setting-title">重置个人资料</view>
            <view class="setting-desc">恢复默认昵称、头像和签名</view>
          </view>
          <text class="setting-link">重置</text>
        </view>
        <view class="setting-row">
          <view>
            <view class="setting-title">当前版本</view>
            <view class="setting-desc">心依AI 1.0.1</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
  <view class="custom-tabbar">
    <button class="tab-item" hover-class="none" bindtap="goHome">
      <image class="tab-icon home-icon" src="/assets/icons/profile_nav_home_inactive.png" mode="aspectFit"></image>
      <text>首页</text>
    </button>
    <button class="tab-item" hover-class="none" bindtap="goHistory">
      <image class="tab-icon history-icon" src="/assets/icons/profile_nav_history_inactive.png" mode="aspectFit"></image>
      <text>历史记录</text>
    </button>
    <button class="tab-item tab-active" hover-class="none" bindtap="goProfile">
      <image class="tab-icon profile-icon" src="/assets/icons/profile_nav_profile_active.png" mode="aspectFit"></image>
      <text>我的</text>
    </button>
  </view>
</view>
