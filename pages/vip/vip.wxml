<view class="vip-page">
  <view class="hero">
    <image class="hero-crown" src="/assets/icons/profile_banner_crown.png" mode="aspectFit"></image>
    <view class="hero-copy">
      <view class="hero-title">心依AI 会员</view>
      <view class="hero-subtitle">解锁无限情感分析、深度建议和历史复盘</view>
    </view>
  </view>

  <view class="usage-card">
    <view class="usage-left">
      <view class="usage-label">免费分析</view>
      <view class="usage-value">{{accessState.remainingFreeCount}}/{{accessState.freeLimit}}</view>
    </view>
    <view class="usage-divider"></view>
    <view class="usage-left">
      <view class="usage-label">会员状态</view>
      <view class="usage-value">{{accessState.vip.active ? accessState.vip.planName : '未开通'}}</view>
    </view>
  </view>

  <view class="plan-list">
    <view wx:for="{{plans}}" wx:key="key" class="plan-card {{selectedPlanKey === item.key ? 'plan-card-active' : ''}}" data-key="{{item.key}}" bindtap="selectPlan">
      <view class="plan-top">
        <view>
          <view class="plan-name">{{item.name}}</view>
          <view class="plan-subtitle">{{item.subtitle}}</view>
        </view>
        <view class="plan-side">
          <view class="plan-badge">{{item.badge}}</view>
          <view class="select-dot {{selectedPlanKey === item.key ? 'select-dot-active' : ''}}"></view>
        </view>
      </view>
      <view class="price-row">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{item.price}}</text>
        <text class="price-unit">{{item.unit}}</text>
      </view>
    </view>
  </view>

  <view class="benefit-card">
    <view class="benefit-title">会员权益</view>
    <view class="benefit-subtitle">{{selectedPlan.name}}专属权益</view>
    <view wx:for="{{selectedPlan.benefits}}" wx:key="*this" class="benefit-item">
      <view class="benefit-dot"></view>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="pay-button" hover-class="none" loading="{{paying}}" disabled="{{paying || accessState.vip.active}}" bindtap="openSelectedPlan">{{accessState.vip.active ? '已开通' : (paying ? '处理中' : '立即开通')}}</button>
    <button class="back-button" hover-class="none" bindtap="goBack">返回</button>
  </view>
</view>
