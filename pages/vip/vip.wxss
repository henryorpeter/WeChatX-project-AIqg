.vip-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 180rpx;
  box-sizing: border-box;
  color: #171827;
  background:
    radial-gradient(circle at 12% 0%, rgba(255, 192, 223, 0.78), transparent 34%),
    radial-gradient(circle at 92% 4%, rgba(207, 188, 255, 0.7), transparent 32%),
    linear-gradient(180deg, #fff3fb 0%, #fffafe 48%, #ffffff 100%);
}

.hero {
  min-height: 154rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(120deg, #241d36 0%, #3c3150 58%, #29223c 100%);
  box-shadow: 0 20rpx 48rpx rgba(43, 34, 58, 0.22);
}

.hero-crown {
  width: 98rpx;
  height: 84rpx;
  flex-shrink: 0;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  color: #ffffff;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.4;
}

.usage-card {
  min-height: 128rpx;
  margin-top: 24rpx;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 38rpx rgba(143, 82, 132, 0.08);
}

.usage-left {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.usage-label {
  color: #8b8798;
  font-size: 23rpx;
}

.usage-value {
  margin-top: 8rpx;
  color: #1c1d2c;
  font-size: 32rpx;
  font-weight: 900;
}

.usage-divider {
  width: 1rpx;
  height: 72rpx;
  background: #eee5f0;
}

.plan-list {
  margin-top: 26rpx;
}

.plan-card {
  position: relative;
  margin-top: 18rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 0 0 1rpx rgba(236, 226, 239, 0.96), 0 14rpx 38rpx rgba(143, 82, 132, 0.07);
}

.plan-card-active {
  background:
    radial-gradient(circle at 100% 0%, rgba(239, 101, 178, 0.14), transparent 34%),
    linear-gradient(180deg, #fff7fc 0%, #ffffff 100%);
  box-shadow: inset 0 0 0 3rpx rgba(239, 101, 178, 0.42), 0 18rpx 48rpx rgba(229, 89, 172, 0.15);
}

.plan-card-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #ef65b2 0%, #bd54ec 100%);
}

.plan-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-top > view:first-child {
  flex: 1;
  min-width: 0;
}

.plan-name {
  color: #1d1f2f;
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 900;
}

.plan-subtitle {
  margin-top: 10rpx;
  color: #777284;
  font-size: 22rpx;
  line-height: 1.35;
}

.plan-badge {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9b4dd6;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  background: #f7efff;
}

.plan-card-active .plan-badge {
  color: #e947a1;
  background: #fff0f8;
}

.plan-side {
  min-width: 142rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.select-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
  background: #ffffff;
  border: 3rpx solid #eadfec;
}

.select-dot-active {
  border: 0;
  background: radial-gradient(circle at 50% 50%, #ffffff 0 24%, transparent 26%), linear-gradient(135deg, #ef65b2 0%, #bd54ec 100%);
}

.price-row {
  margin-top: 24rpx;
  color: #d449a8;
  display: flex;
  align-items: baseline;
}

.plan-card-active .price-row {
  color: #ef4ead;
}

.price-symbol {
  font-size: 28rpx;
  font-weight: 900;
}

.price-value {
  margin-left: 4rpx;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 900;
}

.price-unit {
  margin-left: 6rpx;
  color: #7d758b;
  font-size: 24rpx;
  font-weight: 800;
}

.benefit-card {
  margin-top: 26rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 38rpx rgba(143, 82, 132, 0.07);
}

.benefit-title {
  color: #1d1f2f;
  font-size: 29rpx;
  font-weight: 900;
}

.benefit-subtitle {
  margin-top: 8rpx;
  color: #8b8798;
  font-size: 22rpx;
  line-height: 1.35;
}

.benefit-item {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #5f5b6e;
  font-size: 25rpx;
  line-height: 1.35;
}

.benefit-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ef65b2 0%, #bd54ec 100%);
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  background: rgba(255, 250, 254, 0.94);
  box-shadow: 0 -12rpx 36rpx rgba(151, 115, 151, 0.12);
  backdrop-filter: blur(18rpx);
}

.pay-button,
.back-button {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.pay-button {
  flex: 1;
  color: #ffffff;
  background: linear-gradient(100deg, #ef65b2 0%, #bd54ec 100%);
}

.back-button {
  width: 160rpx;
  color: #706a80;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(232, 224, 235, 0.95);
}
