.doc-page {
  min-height: 100vh;
  padding: 64rpx 30rpx;
  background: linear-gradient(180deg, #fff4fb 0%, #ffffff 100%);
  color: #171827;
}

.doc-title {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.doc-meta {
  margin-top: 12rpx;
  color: #8d8998;
  font-size: 23rpx;
  line-height: 1.4;
}

.doc-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 44rpx rgba(143, 82, 132, 0.08);
}

.doc-section {
  margin-bottom: 28rpx;
}

.doc-section:last-child {
  margin-bottom: 0;
}

.section-title {
  color: #1f2030;
  font-size: 28rpx;
  font-weight: 900;
}

.section-text {
  margin-top: 12rpx;
  color: #666274;
  font-size: 25rpx;
  line-height: 1.65;
}
