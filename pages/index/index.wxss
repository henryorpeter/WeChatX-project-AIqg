.home-page {
  min-height: 100vh;
  padding: 36rpx 30rpx 0;
  background:
    radial-gradient(circle at 0% 0%, rgba(255, 197, 214, 0.78), transparent 33%),
    radial-gradient(circle at 92% 7%, rgba(210, 192, 255, 0.9), transparent 35%),
    linear-gradient(180deg, #fff5fa 0%, #fffafd 42%, #ffffff 100%);
  color: #141624;
}

.hero-area {
  position: relative;
  padding-top: 18rpx;
  padding-bottom: 34rpx;
}

.title-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}

.title-gradient,
.title-main {
  font-size: 52rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
}

.title-gradient {
  color: #ef4fa5;
  background: linear-gradient(135deg, #f4479a 0%, #b65dff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.title-main {
  color: #151827;
}

.title-heart {
  width: 82rpx;
  height: 80rpx;
  margin-left: 2rpx;
}

.subtitle {
  margin-top: 14rpx;
  color: #55576a;
  font-size: 25rpx;
  line-height: 1.5;
}

.subtitle-underline {
  width: 78rpx;
  height: 6rpx;
  margin-left: 252rpx;
  margin-top: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent 0%, #ee79b8 18%, #ee79b8 82%, transparent 100%);
  opacity: 0.62;
}

.analysis-card {
  padding: 30rpx 28rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 24rpx 72rpx rgba(130, 94, 132, 0.12);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.card-title {
  flex: 1;
  color: #171827;
  font-size: 25rpx;
  line-height: 1.38;
  font-weight: 800;
}

.clear-button {
  min-width: 94rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #f04e96;
  font-size: 21rpx;
  font-weight: 700;
  background: #fff0f6;
}

.clear-icon {
  width: 25rpx;
  height: 27rpx;
}

.textarea-wrap {
  position: relative;
  min-height: 216rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 2rpx solid #e7e2ec;
}

.emotion-input {
  width: 100%;
  min-height: 216rpx;
  padding: 22rpx 24rpx 50rpx;
  color: #222333;
  font-size: 24rpx;
  line-height: 1.65;
  background: transparent;
}

.input-placeholder {
  color: #a6a4b4;
  line-height: 1.75;
}

.count-text {
  position: absolute;
  right: 22rpx;
  bottom: 16rpx;
  color: #9694a6;
  font-size: 21rpx;
}

.start-button {
  width: calc(100% - 80rpx);
  height: 74rpx;
  padding: 0;
  margin: 28rpx auto 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 74rpx;
  background: linear-gradient(100deg, #f05a9d 0%, #d65be5 54%, #a856ed 100%);
  box-shadow: 0 18rpx 36rpx rgba(193, 71, 180, 0.24);
}

.start-button[disabled] {
  opacity: 0.72;
}

.start-icon {
  width: 39rpx;
  height: 39rpx;
}

.reference-note {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #9998aa;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

.shield-mini {
  width: 26rpx;
  height: 28rpx;
}

.error-banner {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  color: #a54861;
  font-size: 25rpx;
  line-height: 1.5;
  background: #fff0f3;
  border: 1rpx solid rgba(219, 94, 119, 0.16);
}

.login-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 18, 32, 0.38);
}

.login-sheet {
  width: 100%;
  max-height: 88vh;
  padding: 18rpx 34rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  overflow-y: auto;
  background:
    radial-gradient(circle at 14% 0%, rgba(255, 201, 225, 0.66), transparent 34%),
    linear-gradient(180deg, #fffaff 0%, #ffffff 100%);
  box-shadow: 0 -24rpx 70rpx rgba(52, 38, 65, 0.22);
}

.login-handle {
  width: 82rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #eadfea;
}

.login-kicker {
  display: inline-flex;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  align-items: center;
  color: #e947a1;
  font-size: 21rpx;
  font-weight: 900;
  background: #fff0f8;
}

.login-title {
  margin-top: 16rpx;
  color: #151827;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 900;
}

.quick-login-card {
  width: 100%;
  min-height: 124rpx;
  margin: 28rpx 0 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  text-align: left;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(238, 226, 238, 0.92), 0 12rpx 30rpx rgba(202, 122, 177, 0.08);
}

.quick-login-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.quick-login-copy {
  flex: 1;
  min-width: 0;
}

.quick-login-title {
  color: #1d1f2f;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.agreement-row {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.check-dot {
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: inset 0 0 0 3rpx #d9cedb;
  flex-shrink: 0;
}

.check-dot-active {
  background: linear-gradient(135deg, #ef65b2 0%, #bd54ec 100%);
  box-shadow: inset 0 0 0 8rpx #ffffff, 0 0 0 2rpx rgba(239, 101, 178, 0.46);
}

.agreement-text {
  flex: 1;
  color: #767181;
  font-size: 22rpx;
  line-height: 1.45;
}

.agreement-link {
  color: #e947a1;
  font-weight: 800;
}

.login-primary {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 88rpx;
  background: linear-gradient(100deg, #ef65b2 0%, #d65be5 58%, #a856ed 100%);
  box-shadow: 0 18rpx 40rpx rgba(196, 80, 181, 0.24);
}

.login-primary[disabled],
.login-cancel[disabled] {
  opacity: 0.62;
}

.login-cancel {
  width: 100%;
  height: 72rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  color: #8b8798;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
  background: transparent;
}

.scene-head {
  margin-top: 34rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.scene-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #171827;
  font-size: 26rpx;
  font-weight: 800;
}

.scene-title-icon {
  width: 34rpx;
  height: 32rpx;
}

.change-button {
  height: 46rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #908ca0;
  font-size: 23rpx;
}

.change-icon {
  width: 30rpx;
  height: 29rpx;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 14rpx 0;
}

.scene-item {
  width: calc((100% - 18rpx) / 2);
  min-height: 66rpx;
  padding: 0 14rpx 0 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(244, 134, 184, 0.26);
  box-shadow: 0 8rpx 22rpx rgba(218, 110, 171, 0.08);
}

.scene-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.scene-icon {
  width: 42rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.scene-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1f2030;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene-arrow {
  width: 22rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.privacy-card {
  position: relative;
  min-height: 92rpx;
  margin-top: 30rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  overflow: hidden;
  background: linear-gradient(110deg, #f3e4ff 0%, #fbecff 48%, #f7e9ff 100%);
  box-shadow: 0 14rpx 34rpx rgba(151, 89, 191, 0.12);
}

.privacy-shield {
  width: 94rpx;
  height: 104rpx;
  flex-shrink: 0;
}

.privacy-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.privacy-title {
  color: #6120ad;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.privacy-text {
  margin-top: 6rpx;
  color: #66576f;
  font-size: 22rpx;
  line-height: 1.4;
}

.privacy-swoosh {
  position: absolute;
  right: 66rpx;
  top: 6rpx;
  width: 100rpx;
  height: 88rpx;
  opacity: 0.9;
}

.privacy-arrow {
  position: relative;
  z-index: 2;
  width: 25rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.bottom-spacer {
  height: calc(136rpx + env(safe-area-inset-bottom));
}

.custom-tabbar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 96rpx;
  padding: 4rpx 36rpx 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 -8rpx 38rpx rgba(151, 115, 151, 0.12);
  backdrop-filter: blur(18rpx);
}

.tab-item {
  min-width: 128rpx;
  min-height: 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  padding-top: 2rpx;
  color: #8f8a9c;
  font-size: 22rpx;
  line-height: 1.2;
}

.tab-active {
  color: #e947c9;
}

.tab-icon {
  width: 54rpx;
  height: 54rpx;
}
